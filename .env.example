# OPTIONAL. Everybody else can use config.json instead.
#
# Copy this file to ".env" (same folder as server.js) if you want your own
# admin key locally. .env is git-ignored, so nothing here is ever committed.
#
# In Supabase: your project -> Settings -> API
#
# IMPORTANT:
#   - The service_role / secret key bypasses all security. Server only.
#   - Never put it in public/, config.json, or any committed file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

PORT=4000
